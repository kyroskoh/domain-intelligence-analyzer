# Environment Configuration Template
# Copy this file to .env and update the values as needed

# Application Environment
NODE_ENV=production

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4001

# Backend Configuration  
PORT=4001
LOG_LEVEL=info

# Redis Configuration (Optional)
# Uncomment and configure if using Redis for caching
# REDIS_URL=redis://redis:6379
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
CORS_ORIGINS=http://localhost:4000,http://frontend:4000

# External API Keys (Optional)
# Configure if using external services for enhanced functionality
# WHOIS_API_KEY=your_whois_api_key_here
# DNS_API_KEY=your_dns_api_key_here

# Database Configuration (Future)
# DATABASE_URL=postgresql://user:password@localhost:5432/domain_analyzer
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=domain_analyzer
# DB_USER=domain_analyzer_user
# DB_PASSWORD=your_secure_password_here

# SSL/TLS Configuration (For production with nginx)
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Monitoring & Logging (Future)
# LOG_FILE_PATH=/app/logs/application.log
# METRICS_ENABLED=true
# PROMETHEUS_PORT=9090

# Docker Compose Profiles
# Uncomment to enable optional services
# COMPOSE_PROFILES=redis,nginx

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=10000
HEALTH_CHECK_INTERVAL=30000

# Performance Tuning
NODE_OPTIONS=--max-old-space-size=512

# Development Settings (for development environment)
# DEV_HOT_RELOAD=true
# DEV_WATCH_FILES=true