# Environment Configuration Template
# Copy this file to .env and update the values as needed

# Application Environment
NODE_ENV=production

# Frontend Configuration
# Browser-facing API origin (inlined into the Next.js client at build time).
# ./deploy.sh auto-fills these:
#   - with -p nginx  → https://$DOMAIN_NAME (default domainpeek.xyz)
#   - without nginx  → http://$PUBLIC_HOST:4001 (or http://localhost:4001)
# Override: PUBLIC_API_URL=https://example.com ./deploy.sh -p nginx -r
# Do not use http://backend:4001 here — that hostname only works inside Docker.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001
NEXT_PUBLIC_API_URL=http://localhost:4001
# Server-side only (Next.js /api/health). docker-compose sets INTERNAL_API_URL=http://backend:4001.
# INTERNAL_API_URL=http://backend:4001

# Backend Configuration  
PORT=4001
LOG_LEVEL=info

# RDAP HTTP timeout per server (ms). Default 25000; on timeout try next bootstrap URL (no same-server retry).
RDAP_TIMEOUT_MS=25000
WHOIS_TIMEOUT_MS=10000
DNS_TIMEOUT_MS=5000

# Preferred public hostname (./deploy.sh -p nginx)
DOMAIN_NAME=domainpeek.xyz
# CERTBOT_DOMAINS=www.domainpeek.xyz
# CERTBOT_EMAIL=you@example.com

# Redis Configuration (Compose profiles: redis | default)
# ./deploy.sh ensure_redis_env autofills these when missing.
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
# Optional: set REDIS_PASSWORD (backend merges into REDIS_URL if URL has no auth)
# REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600
SNAPSHOT_TTL_SECONDS=2592000
SHARE_TTL_SECONDS=604800

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security — include every browser origin (public IP / domain) that will load the UI.
# ./deploy.sh auto-merges localhost, domainpeek.xyz (http/https + www), and
# http://<ip-from-ip-a>[:4000]. Optional override: PUBLIC_HOST=<ip> ./deploy.sh
CORS_ORIGINS=http://localhost:4000,http://frontend:4000,https://domainpeek.xyz,http://domainpeek.xyz,https://www.domainpeek.xyz,http://www.domainpeek.xyz

# Backend API protection (shared with nginx profile)
# When set, Express requires API key (X-API-Key or Authorization: Bearer) + X-Request-Nonce
# on /api/* and Socket.IO. Nginx injects X-API-Key, Bearer, and nonce when using -p nginx.
# With -p nginx, the reverse proxy injects both headers (secret stays off the browser).
# Direct calls to :4001 without headers return 401. /health stays open.
# Prefer a long random string. Avoid characters that confuse shell/envsubst ($ ` " \).
# Or generate + autofill: npm run generate:api-key
# API_KEY=change-me-to-a-long-random-secret

# External API Keys (Optional)
# Configure if using external services for enhanced functionality
# WHOIS_API_KEY=your_whois_api_key_here
# DNS_API_KEY=your_dns_api_key_here

# Database Configuration (Future)
# DATABASE_URL=postgresql://user:password@localhost:5432/domain_analyzer
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=domain_analyzer
# DB_USER=domain_analyzer_user
# DB_PASSWORD=your_secure_password_here

# Nginx TLS — Let's Encrypt via Certbot + Cloudflare DNS-01
# Requires compose profile: nginx (COMPOSE_PROFILES=nginx or --profile nginx)
# Token needs Zone → DNS → Edit. Do not commit real tokens.
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# CERTBOT_STAGING=0
# CERTBOT_RENEW_INTERVAL_SECONDS=43200

# Monitoring & Logging (Future)
# LOG_FILE_PATH=/app/logs/application.log
# METRICS_ENABLED=true
# PROMETHEUS_PORT=9090

# Docker Compose Profiles (alternative to ./deploy.sh -p ...)
#   redis   — Redis only
#   nginx   — Nginx reverse proxy only
#   default — nginx + redis
# Recommended CLI (does not require this var): ./deploy.sh -p default -k -u
# COMPOSE_PROFILES=default

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=10000
HEALTH_CHECK_INTERVAL=30000

# Performance Tuning
NODE_OPTIONS=--max-old-space-size=512

# Development Settings (for development environment)
# DEV_HOT_RELOAD=true
# DEV_WATCH_FILES=true