# Backend environment (copy to apps/backend/.env)
# Same filename as apps/frontend/.env — preferred values align with ./deploy.sh -p nginx.

NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# Timeouts (ms)
WHOIS_TIMEOUT_MS=10000
WHOIS_FOLLOW=2
# Per-server RDAP HTTP timeout. No same-server retry on timeout (next bootstrap URL is tried).
RDAP_TIMEOUT_MS=25000
DNS_TIMEOUT_MS=5000

# Rate limiting (Express)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Browser origins allowed by CORS / Socket.IO.
# ./deploy.sh merges localhost, DOMAIN_NAME/SANs, and domainpeek.xyz.
CORS_ORIGINS=http://localhost:4000,https://domainpeek.xyz,http://domainpeek.xyz,https://www.domainpeek.xyz,http://www.domainpeek.xyz

# Redis (Docker profiles: redis | default). ./deploy.sh autofills when missing.
# For local npm run against host-published Redis, override to localhost:
#   REDIS_URL=redis://localhost:6379
#   REDIS_HOST=localhost
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
# Optional: REDIS_PASSWORD=  (backend merges into REDIS_URL if URL has no auth)
# REDIS_PASSWORD=

# Cache / snapshot / share tuning
CACHE_TTL_MINUTES=5
REDIS_TTL_SECONDS=3600
MEMORY_CACHE_SIZE=1000
SNAPSHOT_TTL_SECONDS=2592000
SHARE_TTL_SECONDS=604800

# Shared API key — when set, all /api/* and Socket.IO require API key
# (X-API-Key or Authorization: Bearer) + X-Request-Nonce.
# Production: set the same value in root .env; nginx injects the headers (do not put in NEXT_PUBLIC_*).
# Local without nginx: also set NEXT_PUBLIC_API_KEY in apps/frontend/.env to the same value.
# /health stays open for container healthchecks.
# Generate: npm run generate:api-key   (or --local for frontend too)
# API_KEY=

# Optional external keys
# WHOIS_API_KEY=
# DNS_API_KEY=

# Public base URL (OpenAPI / docs helpers)
API_BASE_URL=http://localhost:4001
