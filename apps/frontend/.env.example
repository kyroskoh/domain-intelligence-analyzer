# Frontend environment (copy to apps/frontend/.env)
# Preferred production values match ./deploy.sh -p nginx.
# Next.js loads .env the same way the backend dotenv loads apps/backend/.env.

# Browser-facing API origin (inlined at Next.js build time).
# deploy.sh with -p nginx → https://$DOMAIN_NAME (default domainpeek.xyz)
# deploy.sh without nginx → http://$PUBLIC_HOST:4001
# Local npm run dev against local API → http://localhost:4001
NEXT_PUBLIC_API_BASE_URL=https://domainpeek.xyz
NEXT_PUBLIC_API_URL=https://domainpeek.xyz

# Server-side health proxy only (Docker sets http://backend:4001).
# For local Next.js → local Express:
INTERNAL_API_URL=http://localhost:4001

NEXT_PUBLIC_APP_ENV=development
PORT=4000
